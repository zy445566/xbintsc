{
  "name": "mathx-rust",
  "description": "Rust math helpers compiled to extern \"C\" and linked by xbintsc",
  "objects": ["target/release/libmathx.a"],
  "linkerFlagsByPlatform": {
    "linux": ["-lpthread", "-ldl", "-lm"],
    "darwin": ["-liconv", "-framework", "Security"],
    "win32": [
      "-ladvapi32",
      "-lbcrypt",
      "-lkernel32",
      "-lntdll",
      "-luserenv",
      "-lws2_32",
      "-lole32",
      "-loleaut32",
      "-lshell32",
      "-lcomctl32",
      "-luuid",
      "-lpsapi",
      "-ldbghelp",
      "-luser32",
      "-lcrypt32",
      "-liphlpapi",
      "-lnetapi32",
      "-lpowrprof",
      "-lsetupapi",
      "-lmswsock",
      "-lversion",
      "-lwintrust",
      "-lshlwapi",
      "-lcomdlg32",
      "-limm32",
      "-lopengl32",
      "-lglu32",
      "-lgdi32",
      "-lwinmm",
      "-ldwmapi",
      "-luxtheme",
      "-lrpcrt4",
      "-lruntimeobject",
      "-lsecur32",
      "-lmsimg32",
      "-loleacc",
      "-lwinspool"
    ]
  },
  "builtins": {
    "rustClamp": { "symbol": "mathx_clamp" }
  },
  "modules": {
    "mathx": {
      "exports": {
        "add": { "symbol": "mathx_add" },
        "fib": { "symbol": "mathx_fib" },
        "fibSequence": { "symbol": "mathx_fib_sequence" },
        "reverse": { "symbol": "mathx_reverse" }
      }
    }
  }
}
