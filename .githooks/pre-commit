#!/bin/sh
#
# Bump the patch version on every commit and fold it into that commit.
# COMPILER_VERSION keys the incremental cache and must match package.json
# (tests/version.test.ts enforces it), so update both in the same step.
# No git tag is created here - release.yml owns tags.
# Installed via: git config core.hooksPath .githooks
set -eu

npm version patch --no-git-tag-version --ignore-scripts >/dev/null
node -e 'const fs = require("fs"); const path = "src/driver/compiler.ts"; const version = require("./package.json").version; const source = fs.readFileSync(path, "utf8"); if (!/COMPILER_VERSION = "/.test(source)) { console.error("COMPILER_VERSION not found in src/driver/compiler.ts"); process.exit(1); } fs.writeFileSync(path, source.replace(/COMPILER_VERSION = "[^"]+"/, `COMPILER_VERSION = "${version}"`));'
git add package.json package-lock.json src/driver/compiler.ts
